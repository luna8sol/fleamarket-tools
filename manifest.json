{
  "manifest_version": 3,
  "name": "Rakuma Bulk Lister",
  "version": "0.1.0",
  "description": "ラクマの出品中商品の一括再出品・下書き商品の一括出品を行う拡張機能",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://fril.jp/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fril.jp/sell*", "https://fril.jp/draft*"],
      "js": ["dist/content-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fril.jp/drafts/*"],
      "js": ["dist/content-edit.js"],
      "run_at": "document_idle"
    }
  ]
}
