{
  "manifest_version": 3,
  "name": "Fleamarket Tools for Mercari",
  "version": "0.1.0",
  "description": "メルカリの下書き商品の一括出品・出品中商品の一括再出品・一括削除・説明文の一括置換を行う拡張機能",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://jp.mercari.com/*", "https://api.anthropic.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jp.mercari.com/mypage/drafts*",
        "https://jp.mercari.com/mypage/listings*",
        "https://jp.mercari.com/sell/create*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jp.mercari.com/sell*"
      ],
      "js": ["dist/edit.js"],
      "run_at": "document_idle"
    }
  ]
}
