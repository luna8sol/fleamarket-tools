{
  "manifest_version": 3,
  "name": "Mercari Draft Publisher",
  "version": "1.0",
  "description": "メルカリ下書き商品を自動で出品する拡張機能",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://jp.mercari.com/*", "https://api.anthropic.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jp.mercari.com/mypage/drafts*",
        "https://jp.mercari.com/mypage/listings*",
        "https://jp.mercari.com/sell*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jp.mercari.com/sell*"
      ],
      "js": ["dist/edit.js"],
      "run_at": "document_idle"
    }
  ]
}
