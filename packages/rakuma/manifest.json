{
  "manifest_version": 3,
  "name": "Fleamarket Tools for Rakuma",
  "version": "0.1.0",
  "description": "フリマサイトの出品作業をまとめて進める拡張機能。一括出品・一括再出品・一括削除・説明文の一括置換",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://fril.jp/*",
    "https://item.fril.jp/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fril.jp/sell*",
        "https://fril.jp/draft*"
      ],
      "js": [
        "dist/content-list.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fril.jp/drafts/*",
        "https://fril.jp/item/new*",
        "https://fril.jp/item/*/edit*"
      ],
      "js": [
        "dist/content-form.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
